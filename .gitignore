# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.python_deps/

# Tooling
.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Experiment output. Runs are reproducible from configs/ plus manifest.json,
# so the artefacts themselves do not belong in version control.
runs/
*.parquet
*.jsonl

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Expert datasets. 8+ GB of rendered frames, fully regenerable from the
# manifest: `uavlab collect --expert c2 --episodes 250` reproduces the set,
# because scene generation is seeded and the seed range is in manifest.json.
data/

# Third-party papers, re-downloadable from the links in papers/small_vla/README.md.
papers/**/*.pdf

# Local same-weight Gemma runtime repair artifacts; scripts/results are tracked.
tmp/gemma_repair_vendor/
tmp/gemma_runtime_repair/

# Local credential configuration
.env
.env.*
!.env.example

.local/gemini_quota_stop

.local/*_quota_stop
.local/*_quota_stop_*

# Generated portable debugger and browser QA images (rebuild from saved logs)
reports/debugger/*.html
reports/debugger/*.png

# Generated dataset playback embeds original JPEGs; rebuild with scripts/build_vla_dataset_viewer.py.
reports/vla_dataset_review_20260916/viewer.html

# Generated local VLA flight replay; raw data retained on D drive.
reports/vla_local_pilot_20260916/*.html

reports/vla_dataset_review_20260916/teacher_flights.html

reports/vla_dataset_review_20260916/model_flights.html

# Generated FRD follow-up playback; scripts and audit reports are tracked.
reports/vla_dataset_review_20260916/data_expansion.html
reports/vla_dataset_review_20260916/frd_comparison.html
reports/vla_frd_followup_20260916/external_contact.png
reports/vla_frd_followup_20260916/model_preview.jpg

# Generated local mixed-model predictions and flights.
reports/vla_dataset_review_20260916/local_mixed_predictions.html
reports/vla_dataset_review_20260916/smol_mixed_flights.html
reports/vla_dataset_review_20260916/qwen_mixed_flights.html

reports/vla_dataset_review_20260916/smol_duration.html

# Reproducible D138 debugger pages; data/reports are separately audited.
reports/vla_dataset_review_20260916/expanded_data.html
reports/vla_dataset_review_20260916/expanded_teacher_flights.html
